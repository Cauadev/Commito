{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Commito",
  "version": "0.2.0",
  "identifier": "dev.commito.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Commito",
        "width": 1480,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false,
        "backgroundColor": "#161b26"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Commito",
    "category": "DeveloperTool",
    "shortDescription": "Cliente Git desktop com grafo de commits",
    "longDescription": "Cliente Git para Windows com grafo de histórico, worktrees, stash, cherry-pick e integração com GitHub, GitLab e Bitbucket.",
    "copyright": "© Commito",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1RTVBQTQ4NEJDMEY3RkEKUldUNjk4QkxTS3JsWlFibmdxcys3TzhXSk1pMjZkRXZqSVAzSFdYc09OYzZVRC9uUTNqZHloMkcK",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}